{
  "manifest_version": 3,
  "name": "GP Downloader Helper",
  "version": "0.2.0",
  "description": "Observador y controlador de Google Fotos para descarga masiva",
  "permissions": ["downloads", "tabs", "debugger"],
  "host_permissions": [
    "https://photos.google.com/*",
    "http://127.0.0.1:8765/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://photos.google.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
