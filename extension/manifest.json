{
  "manifest_version": 3,
  "name": "GP Downloader Helper",
  "version": "0.1.0",
  "description": "Observador de Google Fotos para el sistema de descarga masiva",
  "permissions": ["downloads", "tabs"],
  "host_permissions": ["https://photos.google.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://photos.google.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
